# Copied to .env by `make env`
# The passwords are for local development only

# Owner role: creates the database and runs the migrations
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline-dev
POSTGRES_DB=pipeline

# One login role per service, created by docker/initdb
INGEST_DB_PASSWORD=ingest-dev
DBT_DB_PASSWORD=dbt-dev
API_DB_PASSWORD=api-dev

# Host ports
DB_PORT=5433
API_PORT=8001

# Required by the ingest CLI (no default)
# SEC EDGAR asks for a name and a contact email, such as "Jane Doe jane@example.com"
EDGAR_USER_AGENT=
